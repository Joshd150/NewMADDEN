# VFL Manager Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# For development (Firebase Emulator)
FIRESTORE_EMULATOR_HOST=localhost:8080

# For production (choose one)
SERVICE_ACCOUNT_FILE=path/to/service-account.json
# OR
SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}

# =============================================================================
# DISCORD BOT CONFIGURATION
# =============================================================================

# Discord Bot Credentials
DISCORD_TOKEN=your_discord_bot_token_here
PUBLIC_KEY=your_discord_public_key_here
APP_ID=your_discord_application_id_here

# Bot Settings
BOT_NAME=VFL Manager
BOT_VERSION=2.0.0
BOT_DESCRIPTION=Ultimate Madden Franchise Management

# =============================================================================
# EA API CONFIGURATION (Preserve existing)
# =============================================================================

# Deployment URL for EA callbacks
DEPLOYMENT_URL=https://your-domain.com

# EA API Settings (if needed)
EA_API_TIMEOUT=30000
EA_RETRY_ATTEMPTS=3

# =============================================================================
# WEBSITE CONFIGURATION
# =============================================================================

# Website URLs
NEXT_PUBLIC_SITE_URL=https://maddenvfl.com
NEXT_PUBLIC_API_URL=https://api.maddenvfl.com
WEBSITE_PORT=3000

# Discord Integration
NEXT_PUBLIC_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_APP_ID&permissions=8&scope=bot%20applications.commands

# =============================================================================
# REAL-TIME CONFIGURATION
# =============================================================================

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_CORS_ORIGIN=https://maddenvfl.com

# Redis (for scaling and caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT for API authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# CORS Settings
CORS_ORIGIN=https://maddenvfl.com,http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Google Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Error Tracking
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_key
NEW_RELIC_APP_NAME=VFL Manager

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Development Tools
ENABLE_SWAGGER=true
ENABLE_DEBUG_ROUTES=true
ENABLE_MOCK_DATA=false

# Hot Reload
CHOKIDAR_USEPOLLING=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# VFL Manager Features
VFL_ENABLE_TRADES=true
VFL_ENABLE_COMMISSIONERS=true
VFL_ENABLE_NOTIFICATIONS=true
VFL_ENABLE_ANALYTICS=true
VFL_ENABLE_PLAYER_COMPARISON=true
VFL_ENABLE_WAITLIST=true

# Discord Features
DISCORD_ENABLE_SLASH_COMMANDS=true
DISCORD_ENABLE_BUTTONS=true
DISCORD_ENABLE_MODALS=true
DISCORD_ENABLE_AUTOCOMPLETE=true

# Website Features
WEBSITE_ENABLE_REAL_TIME=true
WEBSITE_ENABLE_DARK_MODE=true
WEBSITE_ENABLE_MOBILE_APP=false

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================

# Twitch Integration (existing)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_SECRET=your_twitch_webhook_secret
TWITCH_CALLBACK_URL=/twitch/webhook

# YouTube Integration (existing)
YOUTUBE_API_KEY=your_youtube_api_key

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP Settings for notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=VFL Manager <noreply@maddenvfl.com>

# =============================================================================
# BACKUP & STORAGE
# =============================================================================

# Google Cloud Storage (for file uploads)
GCS_BUCKET_NAME=vfl-manager-uploads
GCS_PROJECT_ID=your-gcs-project-id

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Database Connection Pooling
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Cache Settings
CACHE_TTL_PLAYERS=300
CACHE_TTL_TEAMS=600
CACHE_TTL_GAMES=60
CACHE_TTL_STANDINGS=300

# API Response Limits
API_MAX_PLAYERS_PER_REQUEST=50
API_MAX_GAMES_PER_REQUEST=100
API_MAX_COMPARISON_PLAYERS=4

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================

# Test Database
TEST_DATABASE_URL=your_test_database_url
TEST_DISCORD_TOKEN=your_test_bot_token

# Test Settings
RUN_INTEGRATION_TESTS=true
MOCK_EA_API=true
MOCK_DISCORD_API=false